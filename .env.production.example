# Copier en .env.production (jamais versionné) et remplir.

# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=bts-hnd-prep.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bts-hnd-prep.example.com
# 1 une fois le certificat HTTPS installé
DJANGO_HTTPS=0
# Alertes (demandes de retrait, erreurs)
DJANGO_ADMINS=Serge Alain <adresse@example.com>

POSTGRES_DB=btshnd
POSTGRES_USER=btshnd
POSTGRES_PASSWORD=

# Fournisseur d'e-mails (réinitialisation du mot de passe, accusés de réception)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BTS-HND Prep <ne-pas-repondre@bts-hnd-prep.example.com>

# Paiement : laisser vide tant que la structure n'est pas créée (CDC 10.4)
EXPLOITANT_STRUCTURE=
EXPLOITANT_NIU=

# Port publié par Nginx sur le serveur
PORT_HTTP=80
