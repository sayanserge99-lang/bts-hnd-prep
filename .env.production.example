# Copier en .env.production (jamais versionné) et remplir.

# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=bts-hnd-prep.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bts-hnd-prep.example.com
# 1 une fois le certificat HTTPS installé
DJANGO_HTTPS=0
# Alertes (demandes de retrait, erreurs)
DJANGO_ADMINS=Serge Alain <adresse@example.com>
# Adresse de l'administration, difficile à deviner, avec la barre finale (les robots essaient « admin/ »)
DJANGO_ADMIN_URL=admin/
# Serveur d'essai (Oracle gratuit) : 1 = bandeau « Serveur d'essai », pas de moteurs de recherche, données de
# démonstration permises. Refusé avec le paiement. 0 (ou absent) pour le vrai site.
DJANGO_SERVEUR_ESSAI=0

POSTGRES_DB=btshnd
POSTGRES_USER=btshnd
POSTGRES_PASSWORD=

# Fournisseur d'e-mails (réinitialisation du mot de passe, accusés de réception)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Port 465 (SSL direct) : EMAIL_PORT=465, EMAIL_USE_SSL=1 et EMAIL_USE_TLS=0.
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=BTS-HND Prep <ne-pas-repondre@bts-hnd-prep.example.com>

# Connexion avec Google : laisser vide pour la désactiver (voir deploy/DEPLOIEMENT.md, section 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiement : laisser vide tant que la structure n'est pas créée (CDC 10.4)
EXPLOITANT_STRUCTURE=
EXPLOITANT_NIU=
EXPLOITANT_ADRESSE=
EXPLOITANT_CONTACT=
# Agrégateur Mobile Money (voir paiements/fournisseurs/) et secret de signature de ses notifications
PAIEMENT_FOURNISSEUR=simule
PAIEMENT_SECRET=
# Codes de réduction : montant payé minimum en FCFA (couvre les frais de l'agrégateur ; 500 si vide)
PAIEMENT_PRIX_MINIMUM=
# Page de paiement de l'agrégateur (autorisée par la Content-Security-Policy)
CSP_FORM_ACTION_EN_PLUS=

# Suivi des erreurs (sentry.io, offre gratuite) : laisser vide pour le désactiver
SENTRY_DSN=

# Port publié par Nginx sur le serveur
PORT_HTTP=80
