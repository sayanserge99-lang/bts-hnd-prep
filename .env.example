DJANGO_SECRET_KEY=a-changer
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Valeurs par défaut : la base PostgreSQL du compose.yaml
POSTGRES_DB=btshnd
POSTGRES_USER=btshnd
POSTGRES_PASSWORD=btshnd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Le paiement reste désactivé tant que ces deux valeurs sont vides (CDC 10.4)
EXPLOITANT_STRUCTURE=
EXPLOITANT_NIU=
